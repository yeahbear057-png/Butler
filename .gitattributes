* text=auto

# 脚本与配置统一 LF，避免在 Windows 上 checkout 后 CI 里 \r 导致的报错
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf

# 二进制
*.png    binary
*.jpg    binary
*.ico    binary
*.jar    binary
*.jks    binary
*.exe    binary
*.zip    binary
